#!/bin/sh
# zig 交叉编译用的 stub pkg-config
# =====================================================================
# 作用：让 vendored 子项目的 pkg_check_modules() / pkg-config 查询
#       在所有模式下都"找不到包"，从而干净降级（可选依赖关闭），
#       而不是报错。本项目 C 库全部 vendored（libusb/libudev 无需系统包），
#       pkg-config 查询的系统包全是可选的：ALSA（QUIET）、HarfBuzz /
#       BZip2 / PNG 等（内部 target 已有，find_package 走不到 pkg-config）。
#
# 用法：tools/zig-linux-*.cmake 里设
#         set(CMAKE_PROGRAM_PATH "${CMAKE_CURRENT_LIST_DIR}/zig-pkg-config")
#       这样 find_package(PkgConfig) 会优先在此目录找到 pkg-config 可执行文件，
#       之后的 pkg_check_modules() 全部返回 *_NOTFOUND，REQUIRED 报错 → 降级路径。
#
# 兼容所有 pkg-config 常见调用形式：
#   pkg-config --exists foo            → 0 失败
#   pkg-config --modversion foo        → 无输出，非 0
#   pkg-config --cflags --libs foo     → 空
#   pkg-config --variable=... foo      → 空
exit 1