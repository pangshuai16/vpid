1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

// SOUI 资源：系统皮肤（theme_sys_res.rc2 引用相对路径 theme_sys_res/*.png）
#include "theme_sys_res.rc2"
// SOUI 资源：应用 UI（src/ui/uires.rc2，跨平台共享的 XML 布局）
#include "uires.rc2"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
  FILEFLAGS       0x0L
  FILEOS          VOS__WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Tu\0"
      VALUE "FileDescription",  "VPid Viewer\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "vpid_viewer\0"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Tu\0"
      VALUE "OriginalFilename", "vpid_viewer.exe\0"
      VALUE "ProductName",      "VPid Viewer\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END