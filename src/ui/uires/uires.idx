<resource>
  <!-- 应用 UI 资源索引（Linux 文件资源提供者使用）
       与 uires.rc2 的资源名/类型一致：SOUI 按 name+type 查找，
       path 相对本目录（uires/）。Windows PE 资源版由 uires.rc2 编入 exe。 -->
  <UIDEF>
    <file name="xml_init" path="uidef/init.xml"/>
  </UIDEF>
  <values>
    <file name="string" path="values/string.xml"/>
    <file name="color" path="values/color.xml"/>
    <file name="skin" path="values/skin.xml"/>
    <file name="template" path="values/template.xml"/>
  </values>
  <LAYOUT>
    <file name="dlg_main" path="xml/dlg_main.xml"/>
  </LAYOUT>
</resource>
