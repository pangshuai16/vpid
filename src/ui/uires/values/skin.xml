<?xml version="1.0" encoding="utf-8"?>
<!--
  皮肤定义（全部为矢量/纯色，无位图资源——保证 XP 与 Linux 渲染一致）
  主题：稳重商务（business-slate v1）· 灰窗底 + 白面板 + 深海蓝主色

  按钮状态索引：0=normal 1=hover 2=pushdown 3=disable

  层级与形状策略：
   · 层级 = 明度差。灰窗底（canvas）与白面板（surface1）拉开，面板天然浮起。
     GDI 渲染没有投影，也不需要——报表工具靠的是边界清楚，不是悬浮感。
   · 圆角统一 3px，只给按钮与徽标。面板 / 表头 / 数据区一律直角：
     表格的锐利对齐感是"专业"的来源，圆角会把数据区变成"卡片流"。
   · 描边用 hairline 收边（几乎看不见）、用 border 表达可交互（≥3:1）。
     两者分工明确，所以界面"看起来有骨架，又不吵"。
   · 整窗只有一个实心按钮（刷新，深海蓝实底）。其余为带描边的幽灵按钮——
     实底块一多，界面就散；只有一个时，视线自动知道"主操作在哪"。
-->
<skin>

  <!-- ============ 结构性表面 ============ -->

  <!-- 应用栏：白，平面。底部由一条发丝线收口 -->
  <colorrect name="appbar" normal="@color/surface1" cornerRadius="0"/>

  <!-- 面板：白底 + 一圈发丝线。
       注意：面板必须 padding="1" 让子控件内缩，否则列表的不透明底色会盖掉这条边框 -->
  <colorrect name="panel"
             normal="@color/surface1"
             normalBorder="@color/hairline"
             borderWidth="1"
             cornerRadius="0"/>

  <!-- 分组条（"全部设备"/"变更记录"小标题条）：比面板重一档 -->
  <colorrect name="section_bar" normal="@color/surface2" cornerRadius="0"/>

  <!-- 状态栏 -->
  <colorrect name="status_bar" normal="@color/surface2" cornerRadius="0"/>

  <!-- ============ 指示器 ============ -->

  <!-- 状态圆点：cornerPercent=0.5 画正圆（直径 8px）。运行中=绿，暂停=灰 -->
  <colorrect name="dot_live" normal="@color/success" cornerPercent="0.5"/>
  <colorrect name="dot_idle" normal="@color/idle"    cornerPercent="0.5"/>

  <!-- 监控状态胶囊（应用栏左侧）：live / idle 两个皮肤互斥显示，避免运行时换肤 -->
  <colorrect name="pill_live"
             normal="@color/successTint"
             normalBorder="@color/successBorder"
             borderWidth="1"
             cornerRadius="13"/>
  <colorrect name="pill_idle"
             normal="@color/idleTint"
             normalBorder="@color/idleBorder"
             borderWidth="1"
             cornerRadius="13"/>

  <!-- 计数徽标（分组条右侧）：淡底 + 语义色描边，比实底计数牌克制 -->
  <colorrect name="badge_neutral"
             normal="@color/surface2"
             normalBorder="@color/border"
             borderWidth="1"
             cornerRadius="3"/>
  <colorrect name="badge_accent"
             normal="@color/accentTint"
             normalBorder="@color/accentBorder"
             borderWidth="1"
             cornerRadius="3"/>
  <colorrect name="badge_danger"
             normal="@color/dangerTint"
             normalBorder="@color/dangerBorder"
             borderWidth="1"
             cornerRadius="3"/>

  <!-- ============ 表头 ============ -->
  <!-- SOUI 表头默认走位图皮肤，这里显式换成纯色三态，彻底脱离系统 PNG -->
  <colorrect name="head_item"
             normal="@color/surface2"
             hover="@color/surface3"
             pushdown="@color/surface4"
             cornerRadius="0"/>

  <!-- ============ 按钮 ============ -->

  <!-- 唯一主按钮：实心深海蓝，无描边（边界由色彩自身承担） -->
  <colorrect name="btn_primary"
             normal="@color/accent"
             hover="@color/accentHover"
             pushdown="@color/accentPress"
             disable="@color/textDisabled"
             cornerRadius="3"/>

  <!-- 幽灵按钮：重置基准 / 复制 —— 淡底 + 3:1 描边，hover 变重 -->
  <colorrect name="btn_ghost"
             normal="@color/surface2"
             hover="@color/surface3"
             pushdown="@color/surface4"
             normalBorder="@color/border"
             hoverBorder="@color/borderStrong"
             pushdownBorder="@color/borderStrong"
             disable="@color/surface2"
             borderWidth="1"
             cornerRadius="3"/>

  <!-- 危险：停止刷新（极淡红底 + 红描边 + 红字，按下才加深） -->
  <colorrect name="btn_danger"
             normal="@color/dangerTint"
             hover="rgb(247,219,220)"
             pushdown="rgb(242,204,206)"
             normalBorder="@color/dangerBorder"
             hoverBorder="@color/danger"
             pushdownBorder="@color/danger"
             borderWidth="1"
             cornerRadius="3"/>

  <!-- 强调幽灵：恢复刷新（淡蓝底，语义上"重新接入实时流"） -->
  <colorrect name="btn_accent"
             normal="@color/accentTint"
             hover="@color/accentTintHover"
             pushdown="rgb(200,218,242)"
             normalBorder="@color/accentBorder"
             hoverBorder="@color/accent"
             pushdownBorder="@color/accent"
             borderWidth="1"
             cornerRadius="3"/>

</skin>
