<?xml version="1.0" encoding="utf-8"?>
<color>
  <!-- Apple HIG 语义色（浅色外观），对应原 Win32 版 theme 命名 -->
  <primary       value="rgb(0,122,255)"/>     <!-- systemBlue -->
  <primaryDark   value="rgb(0,89,214)"/>      <!-- systemBlue 深 -->
  <primaryHover  value="rgb(10,132,255)"/>
  <success       value="rgb(52,199,89)"/>     <!-- systemGreen -->
  <successBg     value="rgb(233,249,239)"/>
  <danger        value="rgb(255,59,48)"/>     <!-- systemRed -->
  <dangerBg      value="rgb(253,236,236)"/>
  <text          value="rgb(29,29,31)"/>
  <textSecondary value="rgb(134,134,139)"/>
  <border        value="rgb(209,209,214)"/>
  <bg            value="rgb(245,245,247)"/>
  <rowEven       value="rgb(250,250,252)"/>
  <white         value="rgb(255,255,255)"/>

  <!-- 列表选中/悬停（原版 ListView 高亮：深蓝底 + 白字，对比度最高） -->
  <selBkgnd      value="rgb(0,89,214)"/>      <!-- systemBlue 深：选中背景，白字可读 -->
  <selHoverBkgnd value="rgb(222,234,254)"/>   <!-- 浅蓝：hover 背景，深色文字可读 -->

  <!-- 按钮体系（与原版 btnFill/btnBorder + shade(+22/-36) 精确一致） -->
  <!-- 停止刷新：深红（白字可读） -->
  <redDeep       value="rgb(214,69,65)"/>
  <redDeepHover  value="rgb(236,91,87)"/>     <!-- +22 -->
  <redDeepPress  value="rgb(178,33,29)"/>     <!-- -36 -->
  <redDeepBorder value="rgb(176,58,53)"/>
  <redDeepBorderHover value="rgb(198,80,75)"/>
  <redDeepBorderPress value="rgb(140,22,17)"/>
  <!-- 自动刷新 / 重置：深绿（白字可读） -->
  <greenDeep       value="rgb(30,158,75)"/>
  <greenDeepHover  value="rgb(52,180,97)"/>
  <greenDeepPress  value="rgb(0,122,39)"/>
  <greenDeepBorder value="rgb(23,131,55)"/>
  <greenDeepBorderHover value="rgb(45,153,77)"/>
  <greenDeepBorderPress value="rgb(0,95,19)"/>
  <!-- 手动刷新 / 复制：systemBlue -->
  <blueBtn       value="rgb(0,122,255)"/>
  <blueBtnHover  value="rgb(22,144,255)"/>
  <blueBtnPress  value="rgb(0,86,219)"/>
  <blueBtnBorder value="rgb(0,89,214)"/>
  <blueBtnBorderHover value="rgb(22,111,236)"/>
  <blueBtnBorderPress value="rgb(0,53,178)"/>
  <btnDisableText value="rgb(165,165,165)"/>
</color>