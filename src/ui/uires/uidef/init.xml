<?xml version="1.0" encoding="utf-8"?>
<UIDEF>
  <!-- 全局默认字体：Segoe UI 13（XP 无则回退 Tahoma，Linux 回退系统 UI 字体） -->
  <deffont value="face:Segoe UI,size:13"/>

  <!-- 尺寸单位：逻辑像素（与原版一致） -->
  <unit defUnit="dp"/>

  <!-- 引用的全局资源表 -->
  <string src="values:string"/>
  <color src="values:color"/>
  <skin src="values:skin"/>
  <template src="values:template"/>

  <!--
    全局样式（= 语义化排版 token）· 稳重商务主题

    字体只用一款：Segoe UI。层次全靠「字重 + 文字深浅 + 位置」拉开。
    不引入第二款字体——运维工具里两种字体混排只会制造噪音
    （旧版用 Courier New 做数据行，是"仪器感"的惯性，代价是牺牲了可读性）。

    字号只有两档：12（元信息/表头/状态栏） / 13（数据行/按钮/分组标签）。
    刻意不塞 14/15/16 这种"接近但不一致"的中间档——那是糊掉层级的元凶。
    需要强调时用字重（600/700）而不是加大字号。

    文字阶梯：
      textPrimary   → 数据行、分组标签（700）：压到近黑，报表要的就是清晰
      textSecondary → 表头、状态栏、中性计数（600）
      textMuted     → 次要元信息
      textDisabled  → 禁用
    字重阶梯：400 数据 · 600 可交互与表头 · 700 数字与分组标签
  -->
  <style>
    <!-- 窗口根：灰窗底（最重的一级），白面板靠"比它亮"浮起 -->
    <class name="cls_dlg_frame" colorBkgnd="@color/canvas"/>

    <!-- 应用栏监控状态胶囊文案（live=主文字色 / idle=次文字色，底色与圆点已编码状态） -->
    <class name="cls_pill_text"      font="face:Segoe UI,size:12,weight:600" colorText="@color/textPrimary"/>
    <class name="cls_pill_text_idle" font="face:Segoe UI,size:12,weight:600" colorText="@color/textSecondary"/>

    <!-- 按钮：统一 13/600，差异只由"底/描边/字色"承担 -->
    <class name="cls_btn_primary" font="face:Segoe UI,size:13,weight:600" colorText="@color/textOnAccent"/>
    <class name="cls_btn_ghost"   font="face:Segoe UI,size:13,weight:600" colorText="@color/textPrimary"/>
    <class name="cls_btn_danger"  font="face:Segoe UI,size:13,weight:600" colorText="@color/danger"/>
    <class name="cls_btn_accent"  font="face:Segoe UI,size:13,weight:600" colorText="@color/accentText"/>

    <!-- 分组条：标签用主文字色 700（浅底上不需要"减重补偿"，那是深色底才需要的技巧） -->
    <class name="cls_section_label" font="face:Segoe UI,size:13,weight:700" colorText="@color/textPrimary"/>
    <!-- 计数徽标：中性=次文字色，新增=蓝，移除=红（文字自带"新增/移除"，颜色只是第二通道） -->
    <class name="cls_count_neutral" font="face:Segoe UI,size:12,weight:700" colorText="@color/textSecondary"/>
    <class name="cls_count_add"     font="face:Segoe UI,size:12,weight:700" colorText="@color/accentText"/>
    <class name="cls_count_del"     font="face:Segoe UI,size:12,weight:700" colorText="@color/danger"/>

    <!-- 数据行：正文字重 400 -->
    <class name="cls_row" font="face:Segoe UI,size:13" colorText="@color/textPrimary"/>

    <!-- 状态栏 -->
    <class name="cls_status"       font="face:Segoe UI,size:12" colorText="@color/textSecondary"/>
    <class name="cls_status_muted" font="face:Segoe UI,size:12" colorText="@color/textMuted"/>
  </style>
</UIDEF>
