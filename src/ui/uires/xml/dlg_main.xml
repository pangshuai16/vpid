<?xml version="1.0" encoding="utf-8"?>
<!-- 主窗口布局：与原 Win32 版 layoutChildren() 1:1 复刻
     客户区 1280x720，工具条 60px，状态栏 24px，pad=16 gap=14
     顶栏: 标题(Segoe UI Bold 19) + 按钮右对齐(高38, 文本宽+48px, 间距10)
     主区: 左60% 全部设备列表 | 右40% 上=+新增(28px chip + 列表) / 下=-移除(28px chip + 列表)
     底栏: statusA 左对齐 | statusB 右对齐（等宽字体 14px）
     布局: root=vbox 自适应（顶栏60 + 分隔线1 + 主区weight=1 + 状态栏24），
           状态栏永远贴底，不依赖 pos 负数语义
     注意: SOUI 线性布局(hbox/vbox)子项必须用 size+weight，不能用 pos！
           size: -1=wrapContent, -2=matchParent, 正数=固定px, 0=由weight分配 -->
<SOUI trCtx="dlg_main"
      title="USB设备ID查看"
      bigIcon="APP_ICON:32"
      smallIcon="APP_ICON:16"
      wndType="appMain"
      appWnd="1"
      wndStyle="47120384"
      margin="0,0,0,0"
      minsize="960,600"
      resizable="1"
      translucent="0"
      alpha="255">
  <!-- 显式声明"系统原生非客户区"：SNcPainter 常驻消息链，其 system=false（默认）时会拦截
       WM_NCCALCSIZE/WM_NCHITTEST/WM_NCLBUTTONDOWN 等并返回"客户区=整窗"，
       导致 WS_CAPTION 系统标题栏无法渲染、按钮点击失效。
       system="true" → SNcPainter 消息映射整体跳过 → 边框/标题栏/按钮/拖拽/缩放全由系统处理 -->
  <ncpainter system="true"/>
  <!-- 窗口使用系统边框（WS_CAPTION 系统标题栏）：拖拽/最小化/关闭/双击最大化/边框缩放
       全部由系统处理（XP 上 100% 可靠）。
       客户区 1280x720 = 纯内容区，root 布局从客户区顶部开始（无自绘标题栏） -->
  <root class="cls_dlg_frame" width="1280" height="720" layout="vbox">

    <!-- ========== 顶栏（60px 白底，原版 WM_PAINT 绘制） ========== -->
    <window size="-2,60" colorBkgnd="@color/white" layout="hbox" gravity="center"
            padding_left="16" padding_right="16" interval="10">
      <!-- 标题：设备数（原版 hFontTitle: Segoe UI Bold 19，白底） -->
      <text name="txt_device_count" class="cls_title" size="-1,-1" text="0 个设备已连接"/>
      <!-- 弹性空隙：把按钮组推到右侧（原版按钮右对齐） -->
      <window size="0,0" weight="1"/>
      <!-- 按钮组：原版 order={0,1,3,2,4} → 停止/自动(互斥) → 重置 → 手动刷新 → 复制
           宽度 = 文本宽 + 双侧 24px 内边距（原版 btnPadx=24, 最小 60px），高 38px -->
      <button name="btn_stop_refresh"  text="停止刷新" class="cls_btn_text" skin="btn_red"
              size="-1,38" padding="24,0,24,0"/>
      <button name="btn_auto_refresh"  text="自动刷新" class="cls_btn_text" skin="btn_green"
              size="-1,38" padding="24,0,24,0" visible="0" display="0"/>
      <button name="btn_baseline"      text="重置"     class="cls_btn_text" skin="btn_green"
              size="-1,38" padding="24,0,24,0"/>
      <button name="btn_manual_refresh" text="手动刷新" class="cls_btn_text" skin="btn_blue"
              size="-1,38" padding="24,0,24,0"/>
      <button name="btn_copy"          text="复制"     class="cls_btn_text" skin="btn_blue"
              size="-1,38" padding="24,0,24,0"/>
    </window>
    <!-- 顶栏分隔线（1px，原版 y=60 处 border 色直线） -->
    <window size="-2,1" colorBkgnd="@color/border"/>

    <!-- ========== 主内容区：左列表 | 右两面板（weight=1 填满） ========== -->
    <window size="-2,0" weight="1" layout="hbox" interval="14"
            padding_left="16" padding_right="16" padding_top="14" padding_bottom="14">

      <!-- 左：全部设备列表（60%，4 列） -->
      <window layout="vbox" size="0,-2" weight="60">
        <listctrl name="lc_all" size="-2,-2" itemHeight="24" headerHeight="24"
                  colorBkgnd="@color/white"
                  colorItemBkgnd="rgb(250,250,252)" colorItemBkgnd2="rgb(255,255,255)"
                  colorItemHotBkgnd="rgb(222,234,254)"
                  colorItemSelBkgnd="rgb(0,89,214)" colorSelText="rgb(255,255,255)"
                  colorText="rgb(29,29,31)" class="cls_mono"
                  hotTrack="0" multiSelection="0">
          <headerStyle align="left" itemSwapEnable="1" fixWidth="0" sortHeader="0" colorBkgnd="@color/white">
            <items>
              <item width="46" align="center">VID</item>
              <item width="46" align="center">PID</item>
              <item width="230" align="left">设备名称</item>
              <item width="400" align="left">路径</item>
            </items>
          </headerStyle>
        </listctrl>
      </window>

      <!-- 右：新增 / 移除 两面板（40%，上下等高无间隙，原版 half 平分） -->
      <window layout="vbox" size="0,-2" weight="40" interval="0">
        <!-- +新增 chip（28px 高，successBg 底，粗体绿字） -->
        <window name="chip_added" size="-2,28" layout="hbox" gravity="center"
                padding_left="8" colorBkgnd="@color/successBg">
          <text name="txt_added_title" class="cls_chip_success" size="-1,-1" text="+ 新增设备  0"/>
        </window>
        <listctrl name="lc_added" size="-2,0" weight="1" itemHeight="24" headerHeight="24"
                  colorBkgnd="@color/white"
                  colorItemBkgnd="rgb(250,250,252)" colorItemBkgnd2="rgb(255,255,255)"
                  colorItemHotBkgnd="rgb(222,234,254)"
                  colorItemSelBkgnd="rgb(0,89,214)" colorSelText="rgb(255,255,255)"
                  colorText="rgb(29,29,31)" class="cls_mono"
                  hotTrack="0" multiSelection="0">
          <headerStyle align="left" itemSwapEnable="1" fixWidth="0" sortHeader="0" colorBkgnd="@color/white">
            <items>
              <item width="46" align="center">VID</item>
              <item width="46" align="center">PID</item>
              <item width="240" align="left">设备名称</item>
            </items>
          </headerStyle>
        </listctrl>
        <!-- -移除 chip（28px 高，dangerBg 底，粗体红字） -->
        <window name="chip_removed" size="-2,28" layout="hbox" gravity="center"
                padding_left="8" colorBkgnd="@color/dangerBg">
          <text name="txt_removed_title" class="cls_chip_danger" size="-1,-1" text="- 移除设备  0"/>
        </window>
        <listctrl name="lc_removed" size="-2,0" weight="1" itemHeight="24" headerHeight="24"
                  colorBkgnd="@color/white"
                  colorItemBkgnd="rgb(250,250,252)" colorItemBkgnd2="rgb(255,255,255)"
                  colorItemHotBkgnd="rgb(222,234,254)"
                  colorItemSelBkgnd="rgb(0,89,214)" colorSelText="rgb(255,255,255)"
                  colorText="rgb(29,29,31)" class="cls_mono"
                  hotTrack="0" multiSelection="0">
          <headerStyle align="left" itemSwapEnable="1" fixWidth="0" sortHeader="0" colorBkgnd="@color/white">
            <items>
              <item width="46" align="center">VID</item>
              <item width="46" align="center">PID</item>
              <item width="240" align="left">设备名称</item>
            </items>
          </headerStyle>
        </listctrl>
      </window>
    </window>

    <!-- ========== 状态栏（24px，bg 底，statusA 左 / statusB 右对齐，等宽 14px） ========== -->
    <window size="-2,24" layout="hbox" gravity="center"
            padding_left="16" padding_right="16" colorBkgnd="@color/bg">
      <text name="txt_status_a" class="cls_status" size="-1,-1" text=""/>
      <window size="0,0" weight="1"/>
      <text name="txt_status_b" class="cls_status" size="-1,-1" text="" align="right"/>
    </window>
  </root>
</SOUI>